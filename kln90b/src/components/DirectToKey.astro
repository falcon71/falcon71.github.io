---
/**
 * The Direct To key, D→, as a key name.
 *
 *   Press <DirectToKey />.
 *
 * The key font has no arrow, and the fallback font's arrow sits low. The arrow is drawn instead, as tall as the
 * capital D and on its baseline, so that it is centered on the letter. Screen readers and copied text get "D→".
 */
---

<kbd class="kln-direct-to-key"
	>D<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M0.5 5H9M5.5 1.5L9 5L5.5 8.5" /></svg><span class="sr-only"
		>→</span
	></kbd
>

<style is:global>
	.kln-direct-to-key svg {
		/* Starlight makes every svg a block */
		display: inline;
		/* The cap height of the key font */
		height: 0.7em;
		width: 0.8em;
		margin-left: 0.1em;
		vertical-align: baseline;
		overflow: visible;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
