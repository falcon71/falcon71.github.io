---
/**
 * A drawing of the whole KLN 90B, front panel and screen, for the hero of the home page. Not interactive: the screen
 * is a generated screen without its fields, and the drawing is one image to screen readers.
 *
 *   <KlnUnit screen="pages/nav/home-nav-1" label="The KLN 90B showing NAV 1 and APT 1" />
 *
 * `markers` adds a number to each control, for a page that names them in a legend next to the drawing (the names stay
 * in HTML, because the drawing is one image to screen readers and to the search). The numbers run from the left side
 * over the buttons under the screen to the right side, in the order of MARKERS below:
 *
 *   <KlnUnit screen="pages/nav/home-nav-1" label="..." markers />
 *
 * The panel is drawn in a 912 x 290 box. The screen window is at 246, 30 and 422 x 196, the ratio of the screen
 * (215 x 100), so the generated screen fills it exactly.
 */
import '../styles/kln-screen.css';
import { blocksFromCapture, screenHtml } from '../lib/screenHtml';
import { loadCapture } from '../lib/screens';
import { type FaceplateSide, labelPosition, leftFaceplate, rightFaceplate } from '../data/faceplate';

interface Props {
	screen: string;
	label: string;
	/** Draw a numbered marker on each control */
	markers?: boolean;
}

const { screen, label, markers = false } = Astro.props;
const { capture, maps } = loadCapture(screen);
const none = new Set<string>();
const stageHtml = screenHtml(blocksFromCapture(capture, none, screen), none, maps);

const keys = [
	{ x: 259, text: 'MSG' },
	{ x: 357, text: 'ALT' },
	{ x: 456, text: '' },
	{ x: 555, text: 'CLR' },
	{ x: 654, text: 'ENT' },
];
/**
 * The numbered markers: the circle at (x, y) and the point of the control it names, which a leader line joins when it
 * is not under the circle. In the order of the legend: left CRSR, left outer knob, left inner knob, MSG, ALT, Direct To,
 * CLR, ENT, power/brightness knob, right CRSR, right outer knob, right inner knob.
 */
const MARKERS = [
	{ x: 172, y: 106, tx: 149, ty: 118 },
	{ x: 92, y: 200, tx: 92, ty: 200 },
	{ x: 118, y: 226, tx: 118, ty: 226 },
	{ x: 286, y: 278, tx: 286, ty: 278 },
	{ x: 384, y: 278, tx: 384, ty: 278 },
	{ x: 483, y: 278, tx: 483, ty: 278 },
	{ x: 582, y: 278, tx: 582, ty: 278 },
	{ x: 681, y: 278, tx: 681, ty: 278 },
	{ x: 818, y: 34, tx: 802, ty: 46 },
	{ x: 741, y: 106, tx: 765, ty: 118 },
	{ x: 777, y: 200, tx: 777, ty: 200 },
	{ x: 819, y: 217, tx: 819, ty: 217 },
];
/** A side's faceplate labels, the left column top to bottom, then the right column */
const placed = (side: FaceplateSide) =>
	[...side.labels]
		.sort((a, b) => a.column - b.column || a.row - b.row)
		.map((label) => ({text: label.text, ...labelPosition(side, label)}));
---

<div class="kln-unit" role="img" aria-label={label} data-pagefind-ignore>
	<svg viewBox="0 0 912 290" aria-hidden="true" class="kln-unit-panel">
		<defs>
			<linearGradient id="kln-unit-face" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#3a3d41" />
				<stop offset="1" stop-color="#26282b" />
			</linearGradient>
			<linearGradient id="kln-unit-recess" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#1a1c1e" />
				<stop offset="1" stop-color="#25272a" />
			</linearGradient>
			<linearGradient id="kln-unit-key" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#f1f1f1" />
				<stop offset="1" stop-color="#bdbdbd" />
			</linearGradient>
			<linearGradient id="kln-unit-flange" x1="0.2" y1="0" x2="0.8" y2="1">
				<stop offset="0" stop-color="#ece7dc" />
				<stop offset="0.55" stop-color="#b9b4aa" />
				<stop offset="1" stop-color="#6f6b65" />
			</linearGradient>
			<radialGradient id="kln-unit-knob" cx="0.4" cy="0.35" r="0.75">
				<stop offset="0" stop-color="#3b3d40" />
				<stop offset="0.7" stop-color="#101112" />
				<stop offset="1" stop-color="#050505" />
			</radialGradient>
		</defs>

		<!-- Faceplate and its three fields -->
		<rect x="1" y="1" width="910" height="288" rx="7" fill="url(#kln-unit-face)" stroke="#55595e" stroke-width="2" />
		<rect x="10" y="10" width="208" height="270" rx="6" fill="url(#kln-unit-recess)" />
		<rect x="694" y="10" width="208" height="270" rx="6" fill="url(#kln-unit-recess)" />
		<rect x="228" y="12" width="458" height="226" rx="9" fill="#0d0e0f" stroke="#4a4e53" stroke-width="2" />
		<rect x="244" y="28" width="426" height="200" rx="3" fill="#000" />

		<g class="kln-unit-labels">
			<!-- Left side -->
			<text x="28" y="50" class="kln-unit-model">KLN 90B TSO</text>
			<g transform="translate(113 128)">
				<rect x="-36" y="-22" width="72" height="44" rx="5" fill="#0b0c0d" />
				<rect x="-30" y="-16" width="60" height="32" rx="4" fill="url(#kln-unit-key)" />
				<text y="7" class="kln-unit-key">CRSR</text>
			</g>
			{placed(leftFaceplate).map(({ text, x, y }) => <text x={x} y={y} class="kln-unit-mid">{text}</text>)}

			<!-- Right side -->
			<text x="862" y="42" class="kln-unit-mid kln-unit-big">GPS</text>
			<text x="862" y="61" class="kln-unit-mid kln-unit-small">PUSH</text>
			<text x="862" y="75" class="kln-unit-mid kln-unit-small">ON</text>
			<!-- The jack, and the brightness knob with its curved arrow, BRT in the gap of the arrow -->
			<circle cx="726" cy="40" r="9" fill="#050505" stroke="#5a5e63" stroke-width="2" />
			<g fill="none" stroke="#e8e8e8" stroke-width="2" stroke-linecap="round">
				<path d="M771.6 80.2A32 32 0 0 1 765.5 74.6" />
				<path d="M758.1 51.2A32 32 0 0 1 762.9 37" />
			</g>
			<path d="M765.5 32.8L766.3 39.1L759.5 34.9Z" fill="#e8e8e8" stroke="#e8e8e8" stroke-width="1.5" stroke-linejoin="round" />
			<text x="759" y="67.5" class="kln-unit-mid kln-unit-small">BRT</text>
			<g transform="translate(790 54)">
				<circle r="19" fill="#050505" />
				<circle r="16.5" fill="url(#kln-unit-knob)" stroke="#34373b" stroke-width="3.5" stroke-dasharray="1.4 1.8" />
				<circle r="11" fill="url(#kln-unit-knob)" />
				<path d="M0 -10V-3" stroke="#cfcfcf" stroke-width="1.6" stroke-linecap="round" />
			</g>
			<g transform="translate(801 128)">
				<rect x="-36" y="-22" width="72" height="44" rx="5" fill="#0b0c0d" />
				<rect x="-30" y="-16" width="60" height="32" rx="4" fill="url(#kln-unit-key)" />
				<text y="7" class="kln-unit-key">CRSR</text>
			</g>
			{placed(rightFaceplate).map(({ text, x, y }) => <text x={x} y={y} class="kln-unit-mid">{text}</text>)}
		</g>

		<!-- Knobs: on each side a large outer knob on a light flange, and a smaller inner knob; the right one pulls for scan -->
		{
			[118, 803].map((cx, side) => (
				<g transform={`translate(${cx} 226)`}>
					<circle r="53" fill="url(#kln-unit-flange)" />
					<circle r="45" fill="#070708" />
					<circle r="43" fill="url(#kln-unit-knob)" stroke="#2e3034" stroke-width="5" stroke-dasharray="1.8 2.2" />
					<circle r="29" fill="#050505" />
					<circle r="27" fill="url(#kln-unit-knob)" stroke="#33363a" stroke-width="4" stroke-dasharray="1.5 1.9" />
					<circle r="21" fill="url(#kln-unit-knob)" stroke="#45484c" stroke-width="1" />
					{side === 1 && (
						<g class="kln-unit-scan" transform="rotate(58)">
							<text y="-2">PULL</text>
							<text y="9">SCAN</text>
						</g>
					)}
				</g>
			))
		}

		<!-- The keys under the screen; the middle one is Direct To -->
		{
			keys.map(({ x, text }) => (
				<g transform={`translate(${x} 262)`}>
					<rect x="-31" y="-19" width="62" height="38" rx="5" fill="#0b0c0d" />
					<rect x="-26" y="-14" width="52" height="28" rx="4" fill="url(#kln-unit-key)" />
					{text ? (
						<text y="7" class="kln-unit-key">{text}</text>
					) : (
						<g fill="none" stroke="#151515" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round">
							<path d="M-12 -7h6a7 7 0 0 1 0 14h-6z" />
							<path d="M-16 0h30M8 -5l6 5-6 5" />
						</g>
					)}
				</g>
			))
		}

		{
			markers && (
				<g class="kln-unit-markers">
					{MARKERS.map(({ x, y, tx, ty }, i) => (
						<g>
							{(x !== tx || y !== ty) && <line x1={x} y1={y} x2={tx} y2={ty} />}
							<circle cx={x} cy={y} r="10" />
							<text x={x} y={y + 5}>{i + 1}</text>
						</g>
					))}
				</g>
			)
		}
	</svg>
	<div class="kln-unit-window">
		<div class="kln-screen">
			<div class="kln-stage" set:html={stageHtml} />
		</div>
	</div>
</div>

<style>
	.kln-unit {
		/* kln-screen.css sets the phosphor color on .kln-figure, which the drawing is not */
		--kln-phosphor: #00d109;
		position: relative;
		aspect-ratio: 912 / 290;
		filter: drop-shadow(0 1.5rem 2.5rem rgba(0, 0, 0, 0.55));
	}

	.kln-unit-panel {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.kln-unit-labels text,
	.kln-unit-scan text {
		font-family: var(--kln-font-heading);
		font-weight: 600;
		fill: #ececec;
		font-size: 17px;
		letter-spacing: 0.02em;
	}

	.kln-unit-mid {
		text-anchor: middle;
	}

	/* Sizes other than the labels' 17px; as specific as .kln-unit-labels text, and after it */
	.kln-unit-labels .kln-unit-model {
		font-size: 15px;
	}

	.kln-unit-labels .kln-unit-small {
		font-size: 12px;
	}

	.kln-unit-labels .kln-unit-big {
		font-size: 26px;
	}

	.kln-unit-labels .kln-unit-key,
	.kln-unit .kln-unit-key {
		text-anchor: middle;
		fill: #151515;
		font-size: 19px;
	}

	.kln-unit .kln-unit-scan text {
		text-anchor: middle;
		font-size: 10px;
		fill: #cfcfcf;
	}

	/* The numbers of the controls: amber discs that read on the dark panel and on the light flanges */
	.kln-unit-markers line {
		stroke: #ffc233;
		stroke-width: 2;
	}

	.kln-unit-markers circle {
		fill: #ffc233;
		stroke: #151515;
		stroke-width: 1.5;
	}

	.kln-unit-markers text {
		font-family: var(--kln-font-heading);
		font-weight: 700;
		font-size: 13px;
		text-anchor: middle;
		fill: #151515;
	}

	/* The screen window, in percent of the 912 x 290 panel */
	.kln-unit-window {
		position: absolute;
		left: calc(246 / 912 * 100%);
		top: calc(30 / 290 * 100%);
		width: calc(422 / 912 * 100%);
		/* Inside a page's text, Starlight puts a top margin on every element after the first; it would push the
		   screen down out of its window */
		margin: 0;
		container-type: inline-size;
	}
</style>
