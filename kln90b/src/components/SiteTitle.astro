---
/**
 * Starlight's site title with a button that hides and shows the site menu on wide screens. On narrow screens
 * Starlight's own menu button does this. The choice is remembered in this browser.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<!-- Runs while the page is parsed, before the menu is drawn, so a hidden menu never flashes up -->
<script is:inline>
	try {
		if (localStorage.getItem('kln-sidebar') === 'hidden') document.documentElement.dataset.sidebarHidden = '';
	} catch {}
</script>
<div class="kln-title">
	<button type="button" class="kln-sidebar-toggle" aria-label="Hide the menu" aria-expanded="true" title="Hide the menu">
		<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
			<rect x="3" y="4.5" width="18" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
			<line x1="9" y1="4.5" x2="9" y2="19.5" stroke="currentColor" stroke-width="1.6" />
			<rect class="kln-sidebar-icon-fill" x="3.8" y="5.3" width="4.4" height="13.4" fill="currentColor" />
		</svg>
	</button>
	<Default />
</div>

<style>
	.kln-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}

	.kln-sidebar-toggle {
		display: none;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 6px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}

	.kln-sidebar-toggle:hover {
		border-color: var(--sl-color-gray-5);
		color: var(--sl-color-white);
	}

	@media (min-width: 50em) {
		.kln-sidebar-toggle {
			display: flex;
		}
	}

	:global(:root[data-sidebar-hidden]) .kln-sidebar-icon-fill {
		opacity: 0;
	}
</style>

<style is:global>
	/* Only the left offset goes; --sl-sidebar-width stays, the right-hand "On this page" column is sized by it */
	@media (min-width: 50em) {
		:root[data-sidebar-hidden],
		:root[data-sidebar-hidden] [data-has-sidebar] {
			--sl-content-inline-start: 0rem;
		}
		:root[data-sidebar-hidden] .sidebar-pane {
			display: none;
		}
	}
</style>

<script>
	const button = document.querySelector<HTMLButtonElement>('.kln-sidebar-toggle')!;
	const root = document.documentElement;

	const update = () => {
		const hidden = 'sidebarHidden' in root.dataset;
		const label = hidden ? 'Show the menu' : 'Hide the menu';
		button.setAttribute('aria-label', label);
		button.title = label;
		button.setAttribute('aria-expanded', String(!hidden));
	};

	button.addEventListener('click', () => {
		const hide = !('sidebarHidden' in root.dataset);
		if (hide) root.dataset.sidebarHidden = '';
		else delete root.dataset.sidebarHidden;
		try {
			localStorage.setItem('kln-sidebar', hide ? 'hidden' : 'shown');
		} catch {}
		update();
	});
	update();
</script>
