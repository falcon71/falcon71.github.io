---
/**
 * An example screen of the unit, drawn in the KLN font.
 *
 * A generated screen is shown by its id, with its explanations from screens/<id>/fields.mdx:
 *   <KlnScreen screen="apt-1-ksea" />
 * It does not repeat any text or field. `title` replaces the title of the generated file. The explanation file writes
 * <Field> and <Term> without imports.
 *
 * Hand-built screens are the exception, for an illustration that is no state of the unit (a status line alone, say). They
 * write the screen text as it appears on the unit, with markup inside a line, and their explanations as <Field> children
 * (imported by the page):
 *   {dis:DIS  45.2nm}  a field with the id "dis", label and value together; pointing at it shows <Field id="dis">
 *   {to!:KSEA}         the field shown inverse (cursor on it)
 *   {to~:KSEA}         the field flashing on the unit (shown with a dashed box here, never animated)
 *   {!:ENT}            inverse text that is not a field; flags combine, e.g. {to!~:KSEA}
 *
 * Half pages are 11 characters wide and 6 rows high, the status line is 23 characters, a full page is 23 x 7.
 *
 * With only `left` or only `right`, the screen is cut in half and shows that side with the middle line. The status
 * line then holds just the name of that side's page, e.g. status="NAV 1" (markup allowed, at most 5 characters).
 */
import { getEntry, render } from 'astro:content';
import '../styles/kln-screen.css';
import '../styles/popover.css';
import Field from './Field.astro';
import Term from './Term.astro';
import { blocksFromCapture, blocksFromMarkup, screenHtml, type MapCheck, type Maps, type ScreenBlocks } from '../lib/screenHtml';
import { checkExplanations, documentedFields, loadCapture } from '../lib/screens';

interface Props {
	/** Id of a generated screen, e.g. "nav-1": the folder in screens/. The figure is #screen-nav-1 */
	screen?: string;
	/** Id of a hand-built screen, e.g. "nav-1". The figure is #screen-nav-1, a field explanation links as #screen-nav-1--dis */
	id?: string;
	/** Caption shown under the screen, e.g. "NAV 1 page". Required for a hand-built screen */
	title?: string;
	left?: string;
	right?: string;
	full?: string;
	status?: string;
}

const { screen, id, title: givenTitle, left, right, full, status } = Astro.props;

let name: string;
let title: string;
let blocks: ScreenBlocks;
let documented: Set<string>;
// Generated screen: the explanations as a component. Hand-built: the rendered <Field> children.
let Explanations: Awaited<ReturnType<typeof render>>['Content'] | undefined;
let docsHtml = '';
let maps: Maps = {};
let mapCheck: MapCheck | undefined;

if (screen !== undefined) {
	if ([id, left, right, full, status].some((v) => v !== undefined)) {
		throw new Error(`KlnScreen screen="${screen}": a generated screen takes no id, left, right, full or status`);
	}
	name = screen;
	const loaded = loadCapture(screen);
	const { capture } = loaded;
	maps = loaded.maps;
	const entry = await getEntry('screenFields', screen);
	if (!entry) {
		throw new Error(`screen ${screen}: screens/${screen}/fields.mdx is missing; it needs a <Field> for each field, then run npm run screens -- ${screen}`);
	}
	checkExplanations(screen, capture, entry.body ?? '');
	documented = documentedFields(capture, entry.body ?? '');
	mapCheck = { screen, mapFields: capture.mapFields };
	blocks = blocksFromCapture(capture, documented, screen);
	title = givenTitle ?? capture.title;
	Explanations = (await render(entry)).Content;
} else {
	if (id === undefined || givenTitle === undefined) throw new Error('KlnScreen needs a screen, or an id and a title');
	name = id;
	title = givenTitle;
	blocks = blocksFromMarkup({ left, right, full, status }, id);
	// The explanations come from the <Field> children. A field on the screen without one stays plain text.
	docsHtml = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
	documented = new Set([...docsHtml.matchAll(/data-field="([^"]+)"/g)].map((m) => m[1]));
	for (const s of blocks.blocks.flatMap((b) => b.rows.flat())) {
		if (s.field && !documented.has(s.field)) {
			console.warn(`KlnScreen ${id}: field "${s.field}" has no <Field> explanation`);
		}
	}
}

// Prefixed, because headings get plain anchors ("NAV 1" becomes #nav-1)
const figureId = `screen-${name}`;
const crop = blocks.crop;
const hasFlash = blocks.blocks.some((b) => b.rows.some((row) => row.some((s) => s.flash)));
const hasFields = documented.size > 0;
const stageHtml = screenHtml(blocks, documented, maps, mapCheck);
---

<figure class="kln-figure" id={figureId} data-crop={crop}>
	<div class="kln-bezel">
		<div class="kln-screen" role="group" aria-label={`${title}, example screen`} data-crop={crop}>
			<div class="kln-stage" set:html={stageHtml} />
		</div>
	</div>
	<figcaption>
		<span class="kln-caption-title">{title}</span>
		{hasFields && <span>Point at or tap a field on the screen for its explanation.</span>}
		{
			hasFlash && (
				<span>
					<span class="kln-legend-flash" aria-hidden="true" />
					Flashes on the unit
				</span>
			)
		}
	</figcaption>
	{
		hasFields && (
			<details class="kln-field-list">
				<summary>All fields on this screen</summary>
				{
					Explanations ? (
						<dl>
							<Explanations components={{ Field, Term }} />
						</dl>
					) : (
						<dl set:html={docsHtml} />
					)
				}
			</details>
		)
	}
</figure>

<script>
	import { attachPopover, showPopover } from '../scripts/popover';

	// A text field is a span, a field drawn on a map is an SVG group
	type FieldElement = HTMLElement | SVGElement;

	function content(figure: HTMLElement, field: FieldElement): Node[] {
		const doc = figure.querySelector<HTMLElement>(`.kln-field-doc[data-field="${field.dataset.field}"]`)!;
		const head = document.createElement('div');
		head.className = 'kln-popover-head';
		// The chip repeats the field's screen text; an element drawn on a map has none, so it gets no chip
		if (!(field instanceof SVGElement)) {
			const chip = document.createElement('span');
			chip.className = 'kln-chip';
			chip.setAttribute('aria-hidden', 'true');
			chip.textContent = field.textContent!.trim();
			head.append(chip);
		}
		const title = document.createElement('strong');
		title.textContent = doc.dataset.title ?? '';
		head.append(title);
		const body = document.createElement('div');
		body.className = 'kln-popover-body';
		body.innerHTML = doc.querySelector('dd')!.innerHTML;
		return [head, body];
	}

	const options = { wide: true, prefer: 'below' as const };

	for (const figure of document.querySelectorAll<HTMLElement>('.kln-figure')) {
		for (const field of figure.querySelectorAll<FieldElement>('.kln-field')) {
			// An element drawn on a map has no text, so a screen reader announces the explanation's title
			if (field instanceof SVGElement) {
				field.setAttribute('aria-label', figure.querySelector<HTMLElement>(`.kln-field-doc[data-field="${field.dataset.field}"]`)!.dataset.title ?? '');
			}
			attachPopover(field, () => content(figure, field), options, () => {
				history.replaceState(null, '', `#${figure.id}--${field.dataset.field}`);
			});
		}
	}

	// A link like #screen-nav-1--dis opens that field's explanation
	function openFromHash() {
		const match = /^#(screen-.+)--([a-z0-9-]+)$/.exec(location.hash);
		const figure = match && document.getElementById(match[1]);
		const field = figure?.querySelector<FieldElement>(`.kln-field[data-field="${match![2]}"]`);
		if (!figure || !field) return;
		figure.scrollIntoView({ block: 'center' });
		showPopover(field, content(figure, field), { ...options, pin: true });
	}

	openFromHash();
	addEventListener('hashchange', openFromHash);

	// Print every field explanation: open the collapsed lists for the printout, then restore them
	let closedLists: HTMLDetailsElement[] = [];
	addEventListener('beforeprint', () => {
		closedLists = [...document.querySelectorAll<HTMLDetailsElement>('.kln-field-list:not([open])')];
		closedLists.forEach((d) => (d.open = true));
	});
	addEventListener('afterprint', () => closedLists.forEach((d) => (d.open = false)));
</script>
