---
/**
 * Synthetic drawing: the kinds of search after power-on and the GPS state STA 1 shows for each, with the time from
 * power-on to the first fix. The times follow from the simulation's acquisition times: 6 to 12 s per satellite for a
 * hot start, a common 2 to 75 s for the other starts plus 30 s of ephemeris data where it is not current, a give-up
 * after 5 minutes, 90 s ± 30 s per satellite in a blind search, and 390 s ± 60 s for the first satellite of an almanac
 * search plus 12.5 minutes for the almanac data.
 */
import GpsFigure from './GpsFigure.astro';

interface Props {
	caption: string;
}
const { caption } = Astro.props;

const boxes = [
	{ x: 10, y: 110, accent: false, lines: ['INIT', 'almanac search', 'about 20 min'] },
	{ x: 330, y: 110, accent: false, lines: ['ACQ', 'predicted satellites', 'seconds to 5 min'] },
	{ x: 10, y: 280, accent: false, lines: ['INIT', 'sky search', 'within 12 min'] },
	{ x: 330, y: 280, accent: true, lines: ['NAV', 'a navigation state', 'after 1 s of TRAN'] },
];
---

<GpsFigure caption={caption} viewBox="0 0 560 372" id="gps-search">
	<defs>
		<marker id="gps-search-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
			<path d="M0 0 L10 5 L0 10 Z" class="arrowhead" />
		</marker>
	</defs>
	<rect x="205" y="10" width="150" height="44" rx="6" class="box" />
	<text x="280" y="39" text-anchor="middle" class="t">Power-on</text>
	{boxes.map((b) => (
		<g>
			<rect x={b.x} y={b.y} width="220" height="90" rx="6" class={b.accent ? 'box-accent' : 'box'} />
			<text x={b.x + 110} y={b.y + 30} text-anchor="middle" class="t big">{b.lines[0]}</text>
			<text x={b.x + 110} y={b.y + 56} text-anchor="middle" class="t">{b.lines[1]}</text>
			<text x={b.x + 110} y={b.y + 79} text-anchor="middle" class="t small t-accent">{b.lines[2]}</text>
		</g>
	))}
	<g marker-end="url(#gps-search-arrow)">
		<line x1="230" y1="54" x2="142" y2="106" class="ax" />
		<line x1="330" y1="54" x2="418" y2="106" class="ax" />
		<line x1="230" y1="182" x2="326" y2="182" class="ax" />
		<line x1="440" y1="200" x2="440" y2="276" class="ax" />
		<line x1="350" y1="200" x2="214" y2="276" class="ax" />
		<line x1="230" y1="325" x2="326" y2="325" class="ax" />
	</g>
	<text x="172" y="84" text-anchor="end" class="t small">old almanac</text>
	<text x="388" y="84" class="t small">almanac current</text>
	<text x="278" y="148" text-anchor="middle" class="t small">almanac</text>
	<text x="278" y="166" text-anchor="middle" class="t small">collected</text>
	<text x="452" y="244" class="t small">fix</text>
	<text x="252" y="246" text-anchor="end" class="t small">no fix in 5 min</text>
	<text x="278" y="316" text-anchor="middle" class="t small">fix</text>
</GpsFigure>
