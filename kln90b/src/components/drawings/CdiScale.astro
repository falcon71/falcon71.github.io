---
/**
 * Synthetic drawing: the D-bar for one and the same cross-track distance (0.6 NM, the course to the left of the
 * aircraft) at each of the three CDI scale factors of the MOD pages, each labeled with the mode that selects it by itself. Five dots on each side; the outer dot is full scale.
 * Drawings use currentColor and the theme variables only, so they work in light and dark mode.
 */
interface Props {
	caption: string;
}
const { caption } = Astro.props;

const XTK = 0.6;
const CENTER = 380;
const DOT = 30;
const rows = [
	{ mode: 'En route', scale: '±5.00 NM', dot: '1 NM per dot', full: 5 },
	{ mode: 'Approach arm', scale: '±1.00 NM', dot: '0.2 NM per dot', full: 1 },
	{ mode: 'Approach active', scale: '±0.30 NM', dot: '0.06 NM per dot', full: 0.3 },
].map((r, i) => {
	// The bar stops at the outer dot beyond full scale
	const dots = Math.min(XTK / r.full, 1) * 5;
	return { ...r, y: 55 + i * 78, marker: CENTER - dots * DOT };
});
const dotOffsets = [-5, -4, -3, -2, -1, 1, 2, 3, 4, 5];
---

<figure class="kln-drawing">
	<svg viewBox="0 0 560 270" role="img" aria-labelledby="cdi-scale-title">
		<title id="cdi-scale-title">{caption}</title>
		{rows.map(r => (
			<g>
				<text x="16" y={r.y - 20} class="small accent">{r.mode}</text>
				<text x="16" y={r.y + 2} class="label">{r.scale}</text>
				<text x="16" y={r.y + 22} class="small">{r.dot}</text>
				{dotOffsets.map(k => <circle cx={CENTER + k * DOT} cy={r.y} r="4" class="dot" />)}
				<path d={`M${CENTER - 8} ${r.y + 7} L${CENTER} ${r.y - 9} L${CENTER + 8} ${r.y + 7} Z`} class="to" />
				<rect x={r.marker - 3} y={r.y - 20} width="6" height="40" class="bar" />
			</g>
		))}
		<text x={CENTER} y="258" class="small" text-anchor="middle">aircraft 0.6 NM right of the course</text>
	</svg>
	<figcaption>{caption}</figcaption>
</figure>

<style>
	.kln-drawing {
		margin: 1.5rem 0 2rem;
		max-width: 36rem;
		padding: 1rem;
		background: var(--kln-figure-bg);
		border-radius: 6px;
		color: var(--sl-color-gray-2);
	}
	svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.dot {
		fill: currentColor;
	}
	.to {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}
	.bar {
		fill: var(--kln-affordance);
	}
	.label {
		fill: currentColor;
		font-family: var(--kln-font-heading);
		font-weight: 600;
		font-size: 17px;
	}
	.small {
		fill: currentColor;
		font-family: var(--kln-font-heading);
		font-size: 14px;
	}
	.accent {
		fill: var(--kln-affordance);
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
